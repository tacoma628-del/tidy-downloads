{"nodes": [{"id": "readme_tidy_downloads", "label": "Tidy Downloads (README)", "file_type": "document", "source_file": "README.md", "source_location": "README.md:1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_preview_by_default", "label": "Preview By Default", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preview is the default and nothing moves until --apply is passed, so a mistaken invocation can never touch the user's files. Safety is chosen over convenience: the destructive path requires an explicit opt-in flag."}, {"id": "readme_move_only_never_delete", "label": "Move-Only, Never Delete Or Overwrite", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The tool only ever moves files. Deletion and overwrite are excluded from the design so that no run can lose data; the worst outcome of a bad run is a file in the wrong folder, which is recoverable."}, {"id": "readme_type_month_layout", "label": "Type/YYYY-MM Folder Layout", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-level grouping: file type first (PDFs, Images, Archives, Videos, Audio, Docs, Other), then year-month. Type is the coarse bucket a person searches by; the month subfolder keeps any one bucket from growing unbounded."}, {"id": "readme_in_progress_download_skip", "label": "In-Progress Download Skipping", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Partial downloads (.crdownload, .download, .part, .tmp), hidden files, and existing directories are skipped, because moving a file a browser is still writing would corrupt it."}, {"id": "readme_collision_suffix", "label": "Name Collision Suffixing", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A destination that already exists gets a numeric suffix (report-2.pdf) rather than being overwritten. This is the mechanism that makes the never-overwrite guarantee true in practice."}, {"id": "readme_move_log", "label": "Move Log For Undo", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every applied run appends 'timestamp  old-path  ->  new-path' to Downloads/tidy-downloads.log. There is no built-in undo command; the log is the undo mechanism, letting a user reverse any move by hand."}, {"id": "readme_mtime_month_source", "label": "Last-Modified Time As Month Source", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The YYYY-MM bucket comes from the file's last-modified time, taken as a proxy for when the download finished. Chosen because mtime is available on every platform without reading browser metadata."}], "edges": [{"source": "readme_tidy_downloads", "target": "tidy_downloads", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:18", "weight": 1.0}, {"source": "readme_tidy_downloads", "target": "readme_preview_by_default", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:5", "weight": 1.0}, {"source": "readme_tidy_downloads", "target": "readme_type_month_layout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:34", "weight": 1.0}, {"source": "readme_tidy_downloads", "target": "readme_move_log", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:49", "weight": 1.0}, {"source": "readme_preview_by_default", "target": "tidy_downloads_apply_moves", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "README.md:5", "weight": 1.0}, {"source": "readme_preview_by_default", "target": "tidy_downloads_parse_args", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "README.md:24", "weight": 1.0}, {"source": "readme_move_only_never_delete", "target": "tidy_downloads_apply_moves", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": "README.md:7", "weight": 1.0}, {"source": "readme_type_month_layout", "target": "tidy_downloads_classify", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "README.md:37", "weight": 1.0}, {"source": "readme_type_month_layout", "target": "tidy_downloads_month_folder", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "README.md:37", "weight": 1.0}, {"source": "readme_in_progress_download_skip", "target": "tidy_downloads_is_skippable", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "README.md:8", "weight": 1.0}, {"source": "readme_collision_suffix", "target": "tidy_downloads_unique_against", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "README.md:10", "weight": 1.0}, {"source": "readme_collision_suffix", "target": "readme_move_only_never_delete", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": "README.md:10", "weight": 1.0}, {"source": "readme_move_log", "target": "tidy_downloads_apply_moves", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "README.md:11", "weight": 1.0}, {"source": "readme_mtime_month_source", "target": "tidy_downloads_month_folder", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "README.md:47", "weight": 1.0}, {"source": "readme_preview_by_default", "target": "tests_test_tidy_downloads_applymovestest_test_preview_does_not_move_files", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": "README.md:5", "weight": 1.0}, {"source": "readme_collision_suffix", "target": "tests_test_tidy_downloads_planmovestest_test_collision_gets_numeric_suffix", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": "README.md:10", "weight": 1.0}, {"source": "readme_in_progress_download_skip", "target": "tests_test_tidy_downloads_planmovestest_test_skips_incomplete_hidden_and_directories", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": "README.md:8", "weight": 1.0}], "hyperedges": [{"id": "safety_guarantees", "label": "Safety Guarantees Of A Destructive-By-Opt-In Tool", "nodes": ["readme_preview_by_default", "readme_move_only_never_delete", "readme_in_progress_download_skip", "readme_collision_suffix", "readme_move_log"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md"}]}
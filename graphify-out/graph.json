    {
      "id": "readme_in_progress_download_skip",
      "label": "In-Progress Download Skipping",
      "author": null,
      "captured_at": null,
      "community": 0,
      "community_name": "Planning Rules Under Test",
      "contributor": null,
      "file_type": "concept",
      "norm_label": "in-progress download skipping",
      "rationale": "Partial downloads (.crdownload, .download, .part, .tmp), hidden files, and existing directories are skipped, because moving a file a browser is still writing would corrupt it.",
      "source_file": "README.md",
      "source_location": "README.md:8",
      "source_url": null
    },
    {
      "id": "readme_move_log",
      "label": "Move Log For Undo",
      "author": null,
      "captured_at": null,
      "community": 1,
      "community_name": "Apply And Move Logging",
      "contributor": null,
      "file_type": "concept",
      "norm_label": "move log for undo",
      "rationale": "Every applied run appends 'timestamp  old-path  ->  new-path' to Downloads/tidy-downloads.log. There is no built-in undo command; the log is the undo mechanism, letting a user reverse any move by hand.",
      "source_file": "README.md",
      "source_location": "README.md:51",
      "source_url": null
    },
    {
      "id": "readme_tidy_downloads",
      "label": "Tidy Downloads (README)",
      "author": null,
      "captured_at": null,
      "community": 1,
      "community_name": "Apply And Move Logging",
      "contributor": null,
      "file_type": "document",
      "norm_label": "tidy downloads (readme)",
      "source_file": "README.md",
      "source_location": "README.md:1",
      "source_url": null
    },
    {
      "id": "readme_preview_by_default",
      "label": "Preview By Default",
      "author": null,
      "captured_at": null,
      "community": 1,
      "community_name": "Apply And Move Logging",
      "contributor": null,
      "file_type": "rationale",
      "norm_label": "preview by default",
      "rationale": "Preview is the default and nothing moves until --apply is passed, so a mistaken invocation can never touch the user's files. Safety is chosen over convenience: the destructive path requires an explicit opt-in flag.",
      "source_file": "README.md",
      "source_location": "README.md:5",
      "source_url": null
    },
    {
      "id": "readme_type_month_layout",
      "label": "Type/YYYY-MM Folder Layout",
      "author": null,
      "captured_at": null,
      "community": 4,
      "community_name": "Type And Month Classification",
      "contributor": null,
      "file_type": "concept",
      "norm_label": "type/yyyy-mm folder layout",
      "rationale": "Two-level grouping: file type first (PDFs, Images, Archives, Videos, Audio, Docs, Other), then year-month. Type is the coarse bucket a person searches by; the month subfolder keeps any one bucket from growing unbounded.",
      "source_file": "README.md",
      "source_location": "README.md:34",
      "source_url": null
    },
    {
      "id": "readme_mtime_month_source",
      "label": "Last-Modified Time As Month Source",
      "author": null,
      "captured_at": null,
      "community": 4,
      "community_name": "Type And Month Classification",
      "contributor": null,
      "file_type": "rationale",
      "norm_label": "last-modified time as month source",
      "rationale": "The YYYY-MM bucket comes from the file's last-modified time, taken as a proxy for when the download finished. Chosen because mtime is available on every platform without reading browser metadata.",
      "source_file": "README.md",
      "source_location": "README.md:47",
      "source_url": null
    },
    {
      "id": "readme_collision_suffix",
      "label": "Name Collision Suffixing",
      "author": null,
      "captured_at": null,
      "community": 7,
      "community_name": "Collision And Overwrite Safety",
      "contributor": null,
      "file_type": "concept",
      "norm_label": "name collision suffixing",
      "rationale": "A destination that already exists gets a numeric suffix (report-2.pdf) rather than being overwritten. This is the mechanism that makes the never-overwrite guarantee true in practice.",
      "source_file": "README.md",
      "source_location": "README.md:10",
      "source_url": null
    },
    {
      "id": "readme_move_only_never_delete",
      "label": "Move-Only, Never Delete Or Overwrite",
      "author": null,
      "captured_at": null,
      "community": 7,
      "community_name": "Collision And Overwrite Safety",
      "contributor": null,
      "file_type": "rationale",
      "norm_label": "move-only, never delete or overwrite",
      "rationale": "The tool only ever moves files. Deletion and overwrite are excluded from the design so that no run can lose data; the worst outcome of a bad run is a file in the wrong folder, which is recoverable.",
      "source_file": "README.md",
      "source_location": "README.md:7",
      "source_url": null
    }
